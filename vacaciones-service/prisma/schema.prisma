generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vacacion {
  id            Int      @id @default(autoincrement())
  funcionarioId Int
  fechaInicio   DateTime
  fechaFin      DateTime
  diasGozados   Int
  gestion       Int
  createdAt     DateTime @default(now())
}
