generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Boleta {
  id            Int      @id @default(autoincrement())
  funcionarioId Int
  periodo       String
  sueldoBruto   Decimal  @db.Decimal(12, 2)
  aporteAfp     Decimal  @db.Decimal(12, 2)
  aporteSalud   Decimal  @db.Decimal(12, 2)
  bonos         Decimal  @db.Decimal(12, 2) @default(0)
  sueldoNeto    Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@unique([funcionarioId, periodo])
}
